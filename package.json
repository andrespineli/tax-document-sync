{
  "name": "tax-document-sync",
  "version": "0.1.0",
  "description": "Local Electron app for automatic Brazilian NF-e document synchronization.",
  "license": "MIT",
  "author": "DevStationTech",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "npm run rebuild:native && NO_SANDBOX=1 electron-vite dev -- --disable-gpu --disable-gpu-compositing --in-process-gpu --enable-unsafe-swiftshader",
    "build": "tsc --noEmit && electron-vite build",
    "lint": "eslint .",
    "preview": "npm run rebuild:native && NO_SANDBOX=1 electron-vite preview -- --disable-gpu --disable-gpu-compositing --in-process-gpu --enable-unsafe-swiftshader",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "vitest",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.9.3",
    "lucide-react": "^0.561.0",
    "node-mde": "^0.14.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "axios": "^1.18.1",
    "fast-xml-parser": "^5.9.3",
    "node-forge": "^1.4.0",
    "@xmldom/xmldom": "^0.9.10"
  }
}
